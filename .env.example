# Contact form — copy to .env.local and fill in real values (never commit .env.local)

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# For local dev you can use Cloudflare's always-pass test keys:
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com) — API key + verified sender
RESEND_API_KEY=
# Optional overrides (defaults shown in code):
# CONTACT_TO_EMAIL=jason.louie.614@gmail.com
# CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
